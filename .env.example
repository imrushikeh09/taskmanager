# ==============================================================================
# Task Manager Backend - Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your actual config.
# NEVER commit the real .env file with production secrets or passwords to Git.
# ==============================================================================

# Django Core Settings
# In development, generate a key using: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-for-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=taskmanager_db
DB_USER=taskmanager_user
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5432
