# ==============================================================================
# Task Manager Backend - Docker Compose Environment Template (.env.docker.example)
# ==============================================================================
# Copy this file to .env.docker before running Docker Compose:
#   cp .env.docker.example .env.docker
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-for-docker
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL Container Configuration
DB_NAME=taskmanager_db
DB_USER=taskmanager_user
DB_PASSWORD=user@123
DB_HOST=postgres
DB_PORT=5432

# Redis & Celery Message Broker Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Container Startup Controls (scripts/entrypoint.sh)
AUTO_MIGRATE=true
COLLECT_STATIC=false
